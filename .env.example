# Vimarśa — Groq AI explanation configuration
#
# END USERS: You do NOT need this file. Just open Vimarśa → "Explanation" tab
# and paste your Groq API key in the box. It is saved locally in the app.
# Get a key at https://console.groq.com/keys
#
# DEVELOPERS ONLY: This file is an optional fallback for `cargo run` / `npm run tauri dev`.
# If you set a key here, the app will use it when no key is saved in the UI.

# Required for the "Explain with Groq" feature (developer fallback).
GROQ_API_KEY=

# Optional. Overrides the default model (openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b
