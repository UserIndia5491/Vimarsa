# Vimarśa — Groq AI explanation configuration
#
# Copy this file to `.env` in the project root and fill in your key,
# or export the variables in your shell. Vimarśa reads them from the
# environment at runtime; the key is never stored by the app.

# Required for the "Explain with Groq" feature.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional. Overrides the default model (openai/gpt-oss-120b).
GROQ_MODEL=